/* Operations manifest — single source of truth for opcodes, handlers, capabilities, and CLI verbs.
 *
 * Usage: define HDL_OP(Name, Id, Handler, Cap, CliVerb) before including this file.
 *   Name    — enum suffix: produces Op##Name in proto::Op
 *   Id      — uint32_t numeric opcode (wire value)
 *   Handler — handler function name in hdl::ipc (e.g. HandlePing)
 *   Cap     — required capability bit (HDL_CAP_* or 0 for always-available ops)
 *   CliVerb — primary CLI command name (C string literal) or nullptr if no dedicated verb
 *
 * The file is intentionally ordered by numeric id for readability.
 */

#ifndef HDL_OP
#error "Define HDL_OP(Name, Id, Handler, Cap, CliVerb) before including ops_manifest.inc"
#endif

